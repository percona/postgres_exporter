#!/bin/sh

set -e

# creating postgres_exporter user if it isn't already there
if ! getent passwd postgres_exporter >/dev/null; then
    useradd \
        --system \
        --no-create-home \
        --shell /sbin/nologin \
        --comment "Prometheus exporter for PostgreSQL server metrics" \
        postgres_exporter >/dev/null
fi

systemctl --system daemon-reload >/dev/null || true

exit 0
